# Shared by every stage: every value in config/mc360.tfvars is declared here so all
# stages read one file. Generated by scripts/discover.sh.

variable "org_id" {
  description = "Numeric organization ID."
  type        = string
}

variable "customer_id" {
  description = "Cloud Identity directory customer ID (for domain-restricted sharing)."
  type        = string
}

variable "org_domain" {
  description = "Primary domain of the signed-in admin account."
  type        = string
}

variable "billing_account" {
  description = "Billing account ID (XXXXXX-XXXXXX-XXXXXX)."
  type        = string
}

variable "region" {
  description = "Primary region."
  type        = string
  default     = "us-central1"
}

variable "dr_region" {
  description = "Disaster-recovery region for the Cloud Run portal."
  type        = string
  default     = "us-east4"
}

variable "folders" {
  description = "Existing folders (folders/NNN) — never created here."
  type = object({
    bootstrap  = string
    networking = string
    nonprod    = string
    platform   = string
    prod       = string
    sandbox    = string
  })
}

variable "projects" {
  description = "Existing project IDs — never created here."
  type = object({
    bootstrap     = string
    network       = string
    dev           = string
    test          = string
    observability = string
    prod_app      = string
    prod_data     = string
  })
}

variable "state_bucket" {
  description = "GCS bucket that holds Terraform state for every stage."
  type        = string
}

variable "create_state_bucket" {
  description = "Create the state bucket in stage 00 (false when it already exists)."
  type        = bool
  default     = false
}

variable "github_repository" {
  description = "owner/repo allowed to deploy through Workload Identity Federation."
  type        = string
}

variable "admin_members" {
  description = "Platform administrators (user:/group:)."
  type        = list(string)
}

variable "iap_members" {
  description = "Who may open the CareNotes portal through IAP."
  type        = list(string)
}

variable "alert_email" {
  description = "Email for budget and monitoring alerts."
  type        = string
}

variable "enable_domain_restriction" {
  description = "Enforce iam.allowedPolicyMemberDomains for the Cloud Identity customer."
  type        = bool
  default     = true
}

variable "enforce_cmek" {
  description = "Enforce CMEK org policies on the prod folder (turn on after stage 03)."
  type        = bool
  default     = false
}

variable "vpcsc_dry_run" {
  description = "Keep the VPC Service Controls perimeter in dry-run mode."
  type        = bool
  default     = true
}

variable "enable_hl7_gateway" {
  description = "Deploy the Linux HL7 MLLP gateway (regional MIG + internal TCP load balancer)."
  type        = bool
  default     = true
}

variable "enable_portal_lb" {
  description = "Deploy the global HTTPS load balancer with Cloud Armor and IAP."
  type        = bool
  default     = true
}

variable "enable_dr_region" {
  description = "Deploy the portal in the DR region behind the global load balancer."
  type        = bool
  default     = true
}

variable "enable_hybrid_vpn" {
  description = "Deploy the HA VPN lab between the hub VPC and a simulated clinic VPC."
  type        = bool
  default     = false
}

variable "enable_binary_authorization" {
  description = "Only allow images from the CareNotes Artifact Registry on Cloud Run."
  type        = bool
  default     = false
}

variable "enable_windows" {
  description = "Windows legacy billing VM (needs a paid billing account)."
  type        = bool
  default     = false
}

variable "portal_domain" {
  description = "Portal hostname; empty uses <load balancer IP>.nip.io."
  type        = string
  default     = ""
}

variable "monthly_budget_usd" {
  description = "Monthly budget per project in USD."
  type        = number
  default     = 10
}

variable "access_policy_id" {
  description = "Existing organization-level Access Context Manager policy number (an org can have only one). Empty = stage 07 creates it."
  type        = string
  default     = ""
}
